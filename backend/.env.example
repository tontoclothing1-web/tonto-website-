# TONTO Clothing Backend — copy to .env and fill in
PORT=5000
# JWT_SECRET: In production, must be a unique random string of 32+ characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# ADMIN_PASSCODE: In production, must be a unique passphrase (10+ characters)
ADMIN_PASSCODE=set-a-custom-admin-passphrase-here
WHATSAPP_PHONE=918248321214
FRONTEND_URL=http://localhost:5173
# --- Supabase (required for persistence) ---
# Create a project at https://supabase.com/dashboard, then:
#   Project Settings → API → copy URL + anon key + service_role key
#   SQL Editor → run backend/supabase/schema.sql once
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# --- Uploads (Supabase Storage, optional) ---
# Create a public bucket named "tonto-uploads" (or set SUPABASE_STORAGE_BUCKET)
SUPABASE_STORAGE_BUCKET=tonto-uploads
